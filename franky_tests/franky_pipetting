from franky import Robot, JointMotion, JointState, CartesianMotion, Affine, ReferenceType
import time

robot = Robot("172.16.0.2")

GRAB_POS = [-1.508, -1.486, 1.641, -2.143, -0.134, 2.072, -0.634]

def move(joints, speed=0.05, settle=0.5):
    robot.relative_dynamics_factor = speed
    robot.recover_from_errors()
    robot.move(JointMotion(JointState(joints)))
    time.sleep(settle)

move(GRAB_POS, speed=0.05, settle=0.8)  # slow first move from unknown position

robot.relative_dynamics_factor = 0.05
robot.recover_from_errors()
robot.move(CartesianMotion(Affine([-0.1, 0.0, 0.0]), ReferenceType.Relative))